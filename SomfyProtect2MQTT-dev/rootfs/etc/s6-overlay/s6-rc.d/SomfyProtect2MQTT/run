#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
umask 077

readonly app_dir="/usr/bin/SomfyProtect2MQTT/somfyProtect2Mqtt"
readonly config_file="/data/config.yaml"
TZ="$(bashio::supervisor.timezone)"
export TZ

bashio::log.info "Generating persistent configuration from addon options"
trap 'rm -f "${config_file}.tmp"' EXIT
{
    echo '# Generated by Home Assistant; edit the addon options instead.'
    yq -P -oy /data/options.json
} > "${config_file}.tmp"

# Convert the UI-friendly list into the mapping expected by SomfyProtect2MQTT.
if yq -e '.homeassistant_config.device_macs | type == "!!seq"' "${config_file}.tmp" > /dev/null 2>&1; then
    yq -i '.homeassistant_config.device_macs |= (map({"key": .device, "value": .mac}) | from_entries)' "${config_file}.tmp"
fi

for key in host port username password ssl; do
    if ! bashio::config.has_value "mqtt.${key}"; then
        bashio::log.info "Using MQTT service value for mqtt.${key}"
        value="$(bashio::services mqtt "${key}")"
        case "${key}" in
            port|ssl) expression='.mqtt[strenv(MQTT_KEY)] = env(MQTT_VALUE)' ;;
            *) expression='.mqtt[strenv(MQTT_KEY)] = strenv(MQTT_VALUE)' ;;
        esac
        MQTT_KEY="${key}" MQTT_VALUE="${value}" yq -i "${expression}" "${config_file}.tmp"
    fi
done
chmod 600 "${config_file}.tmp"
mv "${config_file}.tmp" "${config_file}"

# Keep an existing token when upgrading an already running container.
if [[ ! -e /data/token.json && -f "${app_dir}/config/token.json" ]]; then
    cp "${app_dir}/config/token.json" /data/token.json
    chmod 600 /data/token.json
fi

args=("${app_dir}/main.py" -c "${config_file}")
if bashio::config.true debug; then
    args+=(-v)
fi

bashio::log.info "Starting SomfyProtect2MQTT"
exec python3 "${args[@]}"
